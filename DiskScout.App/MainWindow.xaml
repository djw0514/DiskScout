<Window x:Class="DiskScout.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DiskScout 磁盘侦察" Height="860" Width="1380"
        MinHeight="700" MinWidth="1080" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,0,5,0">
                            <ContentPresenter x:Name="HeaderPresenter" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{StaticResource MutedBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1F2D43"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
                    <TextBlock Text="◫" Foreground="#07130F" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="DiskScout 磁盘侦察" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="找出真正占空间的目录和文件" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Border x:Name="AdminBadge" Background="#332A1B" CornerRadius="7" Padding="10,6" Margin="0,0,8,0">
                    <TextBlock x:Name="AdminBadgeText" Text="普通权限" Foreground="#F4C56A" FontSize="12"/>
                </Border>
                <Button Style="{StaticResource BaseButton}" Content="管理员重启" Padding="12,7" Margin="0,0,8,0" Click="RestartAsAdmin_Click"/>
                <Button Style="{StaticResource BaseButton}" Content="Windows 存储设置" Padding="12,7" Click="OpenStorageSettings_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,4,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="135"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ScopeTextBox" VerticalContentAlignment="Center" ToolTip="输入盘符或文件夹路径，例如 C:\"/>
                <ComboBox x:Name="ThresholdComboBox" Grid.Column="1" Margin="10,0" SelectedIndex="0" ToolTip="大文件判定阈值">
                    <ComboBoxItem Content="≥ 100 MB" Tag="104857600"/>
                    <ComboBoxItem Content="≥ 500 MB" Tag="524288000"/>
                    <ComboBoxItem Content="≥ 1 GB" Tag="1073741824"/>
                    <ComboBoxItem Content="≥ 5 GB" Tag="5368709120"/>
                </ComboBox>
                <Button x:Name="BrowseButton" Grid.Column="2" Style="{StaticResource BaseButton}" Content="选择文件夹" Margin="0,0,10,0" Click="Browse_Click"/>
                <Button x:Name="ScanButton" Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="开始扫描" MinWidth="112" Click="Scan_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel><TextBlock Style="{StaticResource MetricLabel}" Text="已统计容量"/><TextBlock x:Name="TotalSizeText" Style="{StaticResource MetricValue}" Text="—"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel><TextBlock Style="{StaticResource MetricLabel}" Text="文件数量"/><TextBlock x:Name="FileCountText" Style="{StaticResource MetricValue}" Text="—"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel><TextBlock Style="{StaticResource MetricLabel}" Text="目录数量"/><TextBlock x:Name="DirectoryCountText" Style="{StaticResource MetricValue}" Text="—"/></StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card}">
                <StackPanel><TextBlock Style="{StaticResource MetricLabel}" Text="扫描耗时 / 访问问题"/><TextBlock x:Name="DurationText" Style="{StaticResource MetricValue}" Text="—"/></StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="本机磁盘" FontWeight="SemiBold" FontSize="14" Margin="8,4,8,10"/>
                    <ListBox x:Name="DriveList" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="DriveList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="DriveBorder" Background="#0D1422" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12"><ContentPresenter/></Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="DriveBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="DriveBorder" Property="Background" Value="{StaticResource AccentDarkBrush}"/></Trigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DriveBorder" Property="Opacity" Value="0.85"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding UsageText}" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="11"/></Grid>
                                    <ProgressBar Value="{Binding UsagePercent, Mode=OneWay}" Maximum="100" Height="5" Margin="0,9,0,7" Background="#263247" Foreground="{StaticResource AccentBrush}" BorderThickness="0"/>
                                    <TextBlock Text="{Binding SpaceText}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                <TabControl x:Name="ResultTabs" Background="Transparent" BorderThickness="0">
                    <TabItem Header="概览与建议">
                        <Grid Margin="4,14,4,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="空间诊断" FontSize="17" FontWeight="SemiBold" Margin="2,0,0,10"/>
                                <ItemsControl x:Name="InsightsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#101A2A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,0,0,9">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Background="{StaticResource AccentDarkBrush}" CornerRadius="6" Padding="7,4" VerticalAlignment="Top" Margin="0,0,10,0"><TextBlock Text="{Binding LevelText}" Foreground="{StaticResource AccentBrush}" FontSize="11"/></Border>
                                                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="18"/></StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="占用最大的目录" FontSize="17" FontWeight="SemiBold" Margin="2,0,0,10"/>
                                <ItemsControl x:Name="TopFoldersList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,0,2,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding FullPath}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/></StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="12,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="大文件">
                        <Grid Margin="4,12,4,4">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="FileSearchBox" TextChanged="FileSearchBox_TextChanged" ToolTip="输入文件名或路径筛选"/>
                                <Button Grid.Column="1" Style="{StaticResource BaseButton}" Content="复制路径" Margin="10,0,0,0" Click="CopySelectedPath_Click"/>
                                <Button Grid.Column="2" Style="{StaticResource BaseButton}" Content="打开位置" Margin="8,0,0,0" Click="OpenSelected_Click"/>
                                <Button Grid.Column="3" Style="{StaticResource BaseButton}" Content="导出 CSV" Margin="8,0,0,0" Click="ExportCsv_Click"/>
                            </Grid>
                            <DataGrid x:Name="LargeFilesGrid" Grid.Row="1" MouseDoubleClick="LargeFilesGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="文件名" Binding="{Binding Name}" Width="1.5*"/>
                                    <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" SortMemberPath="Size" Width="110"/>
                                    <DataGridTextColumn Header="类型" Binding="{Binding Category}" Width="120"/>
                                    <DataGridTextColumn Header="修改时间" Binding="{Binding ModifiedText}" SortMemberPath="LastWriteTime" Width="145"/>
                                    <DataGridTextColumn Header="完整路径" Binding="{Binding FullPath}" Width="2.5*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="目录排行">
                        <Grid Margin="4,12,4,4">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                                <Button Style="{StaticResource BaseButton}" Content="复制路径" Click="CopySelectedPath_Click"/>
                                <Button Style="{StaticResource BaseButton}" Content="打开目录" Margin="8,0,0,0" Click="OpenSelected_Click"/>
                            </StackPanel>
                            <DataGrid x:Name="FoldersGrid" Grid.Row="1" MouseDoubleClick="FoldersGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="目录" Binding="{Binding Name}" Width="1.2*"/>
                                    <DataGridTextColumn Header="容量（含子目录）" Binding="{Binding SizeText}" SortMemberPath="Size" Width="150"/>
                                    <DataGridTextColumn Header="文件数（含子目录）" Binding="{Binding FileCountText}" SortMemberPath="FileCount" Width="150"/>
                                    <DataGridTextColumn Header="完整路径" Binding="{Binding FullPath}" Width="2.8*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="文件类型">
                        <DataGrid x:Name="CategoriesGrid" Margin="4,12,4,4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="类别" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="总容量" Binding="{Binding SizeText}" SortMemberPath="Size" Width="180"/>
                                <DataGridTextColumn Header="占比" Binding="{Binding PercentageText}" SortMemberPath="Percentage" Width="160"/>
                                <DataGridTextColumn Header="文件数" Binding="{Binding FileCountText}" SortMemberPath="FileCount" Width="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="AI 审查">
                        <Grid Margin="4,12,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="#101A2A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76"/><ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="64"/><ColumnDefinition Width="0.75*"/>
                                        <ColumnDefinition Width="64"/><ColumnDefinition Width="0.8*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="API 地址" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="AiEndpointTextBox" Grid.Column="1" Grid.ColumnSpan="5"
                                             Text="https://api.openai.com/v1/responses"/>

                                    <TextBlock Grid.Row="1" Text="模型" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                    <TextBox x:Name="AiModelTextBox" Grid.Row="1" Grid.Column="1" Text="gpt-4.1-mini" Margin="0,10,10,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="协议" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                    <ComboBox x:Name="AiProtocolComboBox" Grid.Row="1" Grid.Column="3" SelectedIndex="0" Margin="0,10,10,0" SelectionChanged="AiProtocolComboBox_SelectionChanged">
                                        <ComboBoxItem Content="OpenAI Responses" Tag="responses"/>
                                        <ComboBoxItem Content="兼容 Chat API" Tag="chat"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Grid.Column="4" Text="API Key" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                    <PasswordBox x:Name="AiApiKeyBox" Grid.Row="1" Grid.Column="5" Margin="0,10,0,0" ToolTip="仅保存在当前进程内；留空时读取 OPENAI_API_KEY"/>

                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,13,0,0">
                                        <CheckBox x:Name="AiIncludeNamesCheckBox" Content="允许发送文件名和脱敏路径" ToolTip="关闭时只发送扩展名、大小、文件年龄、类别和位置类型"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,10,0">
                                        <TextBlock Text="候选数" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="AiMaxFilesComboBox" SelectedIndex="1" Width="125">
                                            <ComboBoxItem Content="前 50 个" Tag="50"/>
                                            <ComboBoxItem Content="前 100 个" Tag="100"/>
                                            <ComboBoxItem Content="前 200 个" Tag="200"/>
                                            <ComboBoxItem Content="前 500 个" Tag="500"/>
                                            <ComboBoxItem Content="全部大文件" Tag="2000"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <Grid Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ProgressBar x:Name="AiReviewProgressBar" Height="5" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center"
                                                     Background="#263247" Foreground="{StaticResource AccentBrush}" BorderThickness="0" Margin="0,0,10,0"/>
                                        <Button Grid.Column="1" Style="{StaticResource BaseButton}" Content="打开位置" Padding="12,7" Margin="0,0,8,0" Click="OpenSelected_Click"/>
                                        <Button x:Name="AiReviewButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="开始审查" Padding="14,7" Click="AiReview_Click"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" Margin="5,9,5,9">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="默认仅发送元数据，不读取文件内容；建议仅作参考，程序不会自动删除或移动任何文件。"
                                           Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                <TextBlock x:Name="AiStatusText" Grid.Column="1" Text="请先完成磁盘扫描" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            </Grid>

                            <DataGrid x:Name="AiReviewsGrid" Grid.Row="2" MouseDoubleClick="AiReviewsGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="建议" Binding="{Binding ActionText}" Width="105"/>
                                    <DataGridTextColumn Header="置信度" Binding="{Binding ConfidenceText}" Width="75"/>
                                    <DataGridTextColumn Header="文件" Binding="{Binding File.Name}" Width="1.1*"/>
                                    <DataGridTextColumn Header="大小" Binding="{Binding File.SizeText}" SortMemberPath="File.Size" Width="105"/>
                                    <DataGridTextColumn Header="理由" Binding="{Binding Reason}" Width="2.2*"/>
                                    <DataGridTextColumn Header="建议位置" Binding="{Binding TargetText}" Width="1.1*"/>
                                    <DataGridTextColumn Header="判定来源" Binding="{Binding SourceText}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="访问问题">
                        <Grid Margin="4,12,4,4">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="这些项目未计入统计；系统保护目录出现“无权限”通常属于正常现象。" Foreground="{StaticResource MutedBrush}" Margin="5,0,0,10"/>
                            <DataGrid x:Name="IssuesGrid" Grid.Row="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="状态" Binding="{Binding KindText}" Width="100"/>
                                    <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="2*"/>
                                    <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="3,8,3,0">
            <ProgressBar x:Name="ScanProgressBar" Height="3" VerticalAlignment="Top" IsIndeterminate="False" Visibility="Collapsed" Foreground="{StaticResource AccentBrush}" Background="#223047" BorderThickness="0"/>
            <TextBlock x:Name="StatusText" Text="选择一个磁盘或目录后开始扫描" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Grid>
</Window>
